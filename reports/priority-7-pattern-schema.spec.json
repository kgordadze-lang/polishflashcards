{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://popolsku.app/spec/priority-7-pattern-schema-phase-1.json",
  "title": "Priority 7 Phase 1 pattern specification artifact",
  "description": "Phase 1 fictional-fixture schema only; it validates the specification example and clean same-record invariants. It is neither the future full private-editorial schema nor the public-runtime-projection schema. Phase 2A owns those two separate schemas plus global ID/parent ownership, reciprocal links, review transition history and current scope-digest matching, registry resolution, repository-source resolution, tombstones, frozen baselines, rights checks, and derived parent CEFR floors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactStatus",
    "specificationNotice",
    "formatVersion",
    "patternDataRevision",
    "lemmas"
  ],
  "properties": {
    "artifactStatus": {
      "const": "specification-example-not-production"
    },
    "specificationNotice": {
      "type": "string",
      "minLength": 20
    },
    "formatVersion": {
      "const": 1
    },
    "patternDataRevision": {
      "type": "integer",
      "minimum": 1
    },
    "lemmas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lemma"
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "scopeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "caseId": {
      "enum": [
        "nominative",
        "genitive",
        "dative",
        "accusative",
        "instrumental",
        "locative",
        "vocative"
      ]
    },
    "cefrLevel": {
      "enum": [
        "A1",
        "A2",
        "B1",
        "above-b1"
      ]
    },
    "role": {
      "enum": [
        "subject",
        "object",
        "recipient",
        "experiencer",
        "predicate",
        "content",
        "topic",
        "interlocutor",
        "means",
        "target"
      ]
    },
    "questionOverride": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "baseComplement": {
      "type": "object",
      "required": [
        "type",
        "required",
        "role"
      ],
      "properties": {
        "type": {
          "enum": [
            "case",
            "preposition-case",
            "infinitive",
            "clause"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "questionOverridePl": {
          "$ref": "#/$defs/questionOverride"
        }
      }
    },
    "caseComplement": {
      "allOf": [
        {
          "$ref": "#/$defs/baseComplement"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "case",
            "required",
            "role"
          ],
          "properties": {
            "type": {
              "const": "case"
            },
            "case": {
              "enum": [
                "nominative",
                "genitive",
                "dative",
                "accusative",
                "instrumental"
              ]
            },
            "required": {
              "type": "boolean"
            },
            "role": {
              "$ref": "#/$defs/role"
            },
            "questionOverridePl": {
              "$ref": "#/$defs/questionOverride"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "case": {
                    "const": "nominative"
                  }
                },
                "required": [
                  "case"
                ]
              },
              "then": {
                "properties": {
                  "role": {
                    "enum": [
                      "subject",
                      "predicate"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "prepositionCaseComplement": {
      "allOf": [
        {
          "$ref": "#/$defs/baseComplement"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "preposition",
            "case",
            "required",
            "role"
          ],
          "properties": {
            "type": {
              "const": "preposition-case"
            },
            "preposition": {
              "type": "string",
              "pattern": "^[a-ząćęłńóśźż]+$"
            },
            "case": {
              "enum": [
                "genitive",
                "dative",
                "accusative",
                "instrumental",
                "locative"
              ]
            },
            "required": {
              "type": "boolean"
            },
            "role": {
              "$ref": "#/$defs/role"
            },
            "questionOverridePl": {
              "$ref": "#/$defs/questionOverride"
            }
          }
        }
      ]
    },
    "infinitiveComplement": {
      "allOf": [
        {
          "$ref": "#/$defs/baseComplement"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "required",
            "role"
          ],
          "properties": {
            "type": {
              "const": "infinitive"
            },
            "required": {
              "type": "boolean"
            },
            "role": {
              "$ref": "#/$defs/role"
            },
            "questionOverridePl": {
              "$ref": "#/$defs/questionOverride"
            }
          }
        }
      ]
    },
    "clauseComplement": {
      "allOf": [
        {
          "$ref": "#/$defs/baseComplement"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "clauseKind",
            "required",
            "role"
          ],
          "properties": {
            "type": {
              "const": "clause"
            },
            "clauseKind": {
              "enum": [
                "ze",
                "czy",
                "zeby",
                "interrogative"
              ]
            },
            "required": {
              "type": "boolean"
            },
            "role": {
              "$ref": "#/$defs/role"
            },
            "questionOverridePl": {
              "$ref": "#/$defs/questionOverride"
            }
          }
        }
      ]
    },
    "complement": {
      "oneOf": [
        {
          "$ref": "#/$defs/caseComplement"
        },
        {
          "$ref": "#/$defs/prepositionCaseComplement"
        },
        {
          "$ref": "#/$defs/infinitiveComplement"
        },
        {
          "$ref": "#/$defs/clauseComplement"
        }
      ]
    },
    "cefr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recognition"
      ],
      "properties": {
        "recognition": {
          "$ref": "#/$defs/cefrLevel"
        },
        "production": {
          "$ref": "#/$defs/cefrLevel"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recognition": {
                "const": "A2"
              }
            },
            "required": [
              "recognition"
            ]
          },
          "then": {
            "properties": {
              "production": {
                "enum": [
                  "A2",
                  "B1"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recognition": {
                "const": "B1"
              }
            },
            "required": [
              "recognition"
            ]
          },
          "then": {
            "properties": {
              "production": {
                "const": "B1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recognition": {
                "const": "above-b1"
              }
            },
            "required": [
              "recognition"
            ]
          },
          "then": {
            "not": {
              "required": [
                "production"
              ]
            }
          }
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "register"
      ],
      "properties": {
        "priority": {
          "enum": [
            "core",
            "common",
            "limited"
          ]
        },
        "register": {
          "enum": [
            "neutral",
            "formal",
            "informal"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "priority": {
                "const": "limited"
              }
            },
            "required": [
              "priority"
            ]
          },
          "then": {
            "required": [
              "note"
            ]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceKind",
        "locator",
        "factType",
        "checkedAt"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/key"
        },
        "sourceKind": {
          "enum": [
            "repository",
            "medak-research",
            "contemporary-reference",
            "contemporary-corpus"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 3
        },
        "factType": {
          "enum": [
            "lemma",
            "meaning",
            "complement-frame",
            "usage-register",
            "contrast",
            "cefr"
          ]
        },
        "checkedAt": {
          "$ref": "#/$defs/date"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "reviewEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "decision",
        "reviewerRef",
        "reviewedAt"
      ],
      "properties": {
        "kind": {
          "enum": [
            "external-verification",
            "native-linguistic",
            "product-approval",
            "reopen",
            "correction"
          ]
        },
        "decision": {
          "enum": [
            "accept",
            "changes-requested",
            "defer",
            "reject"
          ]
        },
        "scopeVersion": {
          "const": 1
        },
        "scopeDigest": {
          "$ref": "#/$defs/scopeDigest"
        },
        "supportingEvidenceDigests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scopeDigest"
          }
        },
        "reviewerRef": {
          "$ref": "#/$defs/key"
        },
        "reviewedAt": {
          "$ref": "#/$defs/date"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "enum": [
                  "changes-requested",
                  "defer",
                  "reject"
                ]
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "required": [
              "note"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "scopeVersion"
                  ]
                },
                {
                  "required": [
                    "scopeDigest"
                  ]
                },
                {
                  "required": [
                    "supportingEvidenceDigests"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "external-verification",
                  "native-linguistic",
                  "product-approval"
                ]
              },
              "decision": {
                "const": "accept"
              }
            },
            "required": [
              "kind",
              "decision"
            ]
          },
          "then": {
            "required": [
              "scopeVersion",
              "scopeDigest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external-verification"
              },
              "decision": {
                "const": "accept"
              }
            },
            "required": [
              "kind",
              "decision"
            ]
          },
          "then": {
            "required": [
              "supportingEvidenceDigests"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "native-linguistic",
                  "product-approval"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "supportingEvidenceDigests"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "reopen",
                  "correction"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "decision": {
                "const": "accept"
              }
            },
            "required": [
              "note"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "scopeVersion"
                  ]
                },
                {
                  "required": [
                    "scopeDigest"
                  ]
                },
                {
                  "required": [
                    "supportingEvidenceDigests"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "repositorySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "field"
      ],
      "properties": {
        "kind": {
          "enum": [
            "card",
            "drill"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "field": {
          "enum": [
            "pl",
            "ex",
            "prompt",
            "answer"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "card"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "field": {
                "enum": [
                  "pl",
                  "ex"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "drill"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "field": {
                "enum": [
                  "prompt",
                  "answer"
                ]
              }
            }
          }
        }
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "original",
            "repository-reuse",
            "specification-fixture"
          ],
          "description": "specification-fixture is forbidden by the future production validator."
        },
        "authorRef": {
          "$ref": "#/$defs/key"
        },
        "authoredAt": {
          "$ref": "#/$defs/date"
        },
        "repositorySource": {
          "$ref": "#/$defs/repositorySource"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "original",
                  "specification-fixture"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "authorRef",
              "authoredAt"
            ],
            "not": {
              "required": [
                "repositorySource"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "repository-reuse"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "repositorySource"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "authorRef"
                  ]
                },
                {
                  "required": [
                    "authoredAt"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "pl",
        "en",
        "origin",
        "audioEligible"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^vp-e-[a-z0-9-]+-[0-9a-f]{12}$"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "pl": {
          "type": "string",
          "minLength": 3
        },
        "en": {
          "type": "string",
          "minLength": 3
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "audioEligible": {
          "type": "boolean"
        }
      }
    },
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "purpose"
      ],
      "properties": {
        "kind": {
          "enum": [
            "card",
            "topic",
            "drill",
            "scenario"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "purpose": {
          "enum": [
            "support",
            "practice",
            "context",
            "contrast"
          ]
        }
      }
    },
    "errorNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "incorrectForm",
        "guidanceEn"
      ],
      "properties": {
        "kind": {
          "enum": [
            "documented-common-error",
            "predicted-distractor"
          ]
        },
        "incorrectForm": {
          "type": "string",
          "minLength": 1
        },
        "guidanceEn": {
          "type": "string",
          "minLength": 3
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "documented-common-error"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "evidenceRefs"
            ]
          }
        }
      ]
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "relationType",
        "complements",
        "cefr",
        "teachingStatus",
        "usage",
        "learnerExplanationEn",
        "activityEligibility",
        "evidence",
        "reviewState",
        "reviewEvents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^vp-p-[a-z0-9-]+-[0-9a-f]{12}$"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "relationType": {
          "enum": [
            "lexical-frame",
            "constructional-frame",
            "means-method",
            "subject-experiencer"
          ]
        },
        "complements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/complement"
          }
        },
        "cefr": {
          "$ref": "#/$defs/cefr"
        },
        "teachingStatus": {
          "enum": [
            "active-production",
            "recognition-only",
            "deferred"
          ]
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "learnerExplanationEn": {
          "type": "string",
          "minLength": 3
        },
        "activityEligibility": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "reference",
              "search",
              "grammar-choose",
              "grammar-build",
              "type-it",
              "listening",
              "mixed-quiz",
              "case-mix",
              "conversation"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "reviewState": {
          "enum": [
            "research",
            "externally-verified",
            "native-reviewed",
            "approved",
            "deferred",
            "rejected"
          ]
        },
        "reviewEvents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewEvent"
          }
        },
        "aspectEquivalentPatternIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^vp-p-[a-z0-9-]+-[0-9a-f]{12}$"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "contentRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentRef"
          }
        },
        "errorNotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/errorNote"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "teachingStatus": {
                "const": "active-production"
              }
            },
            "required": [
              "teachingStatus"
            ]
          },
          "then": {
            "properties": {
              "cefr": {
                "required": [
                  "production"
                ],
                "properties": {
                  "production": {
                    "enum": [
                      "A1",
                      "A2",
                      "B1"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "usage": {
                "properties": {
                  "priority": {
                    "const": "limited"
                  }
                },
                "required": [
                  "priority"
                ]
              }
            },
            "required": [
              "usage"
            ]
          },
          "then": {
            "properties": {
              "teachingStatus": {
                "enum": [
                  "recognition-only",
                  "deferred"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "teachingStatus": {
                "const": "recognition-only"
              }
            },
            "required": [
              "teachingStatus"
            ]
          },
          "then": {
            "properties": {
              "cefr": {
                "not": {
                  "required": [
                    "production"
                  ]
                }
              },
              "activityEligibility": {
                "not": {
                  "contains": {
                    "enum": [
                      "grammar-build",
                      "type-it"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "teachingStatus": {
                "const": "deferred"
              }
            },
            "required": [
              "teachingStatus"
            ]
          },
          "then": {
